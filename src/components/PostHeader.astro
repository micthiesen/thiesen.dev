---
import { isPublished, postPath } from "../../packages/content-core/index";
import { formatDate, type Post } from "../lib/posts";

interface Props {
  post: Post;
  linked?: boolean;
}
const { post, linked = false } = Astro.props;
const published = isPublished(post.data, new Date());
---

<header class="post-header">
  {!published && (
    <p class="draft-notice">
      {post.data.status === "draft" ? "Draft" : "Scheduled"} · Local preview
    </p>
  )}
  <h1>
    {linked ? <a href={postPath(post.id)}>{post.data.title}</a> : post.data.title}
  </h1>
  {post.data.publishedAt && (
    <p class="post-date">
      <time datetime={post.data.publishedAt}>{formatDate(post.data.publishedAt)}</time>
      {post.data.updatedAt && post.data.updatedAt !== post.data.publishedAt && (
        <>
          {" · Updated "}
          <time datetime={post.data.updatedAt}>{formatDate(post.data.updatedAt)}</time>
        </>
      )}
    </p>
  )}
</header>
