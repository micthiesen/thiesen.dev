---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../lib/posts";
const posts = (await getPosts()).filter((post) => post.data.kind === "project");
---

<Base
  title="Projects"
  description="Projects and technical write-ups by Michael Thiesen."
>
  <header class="page-header measure">
    <p class="eyebrow">Selected & ongoing</p>
    <h1>Projects</h1>
    <p class="dek">Things I’ve built, how they work, and what I learned.</p>
  </header>
  {posts.length ? (
    <PostList posts={posts} showImages />
  ) : (
    <p class="empty-state">Project write-ups are on their way.</p>
  )}
</Base>
