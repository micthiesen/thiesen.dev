---
import Base from "../layouts/Base.astro";
import JsonLd from "../components/JsonLd.astro";
import { author } from "../lib/author";
---

<Base
  title="About"
  description="Michael Thiesen is a software engineer in Vancouver who builds software and hardware."
>
  <article>
    <header class="page-header">
      <h1>About</h1>
    </header>
    <div class="prose">
      <p>
        I’m Michael Thiesen, a software engineer in Vancouver. I build software,
        hardware, and occasionally things that probably didn’t need to exist. I write
        about engineering, AI, electronics, and whatever else I’ve been obsessing over
        lately.
      </p>
      <p>
        My code is on <a href="https://github.com/micthiesen">GitHub</a>. New posts are
        available through <a href="/feed.xml">RSS</a>.
      </p>
    </div>
  </article>
  <JsonLd data={{ "@type": "ProfilePage", mainEntity: author }} />
</Base>
