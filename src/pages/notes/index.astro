---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../lib/posts";
const posts = (await getPosts()).filter((post) => post.data.kind === "note");
---

<Base
  title="Notes"
  description="Notes on software, tools, and experiments by Michael Thiesen."
>
  <header class="page-header measure">
    <p class="eyebrow">From the notebook</p>
    <h1>Notes</h1>
    <p class="dek">Small observations, experiments, and ideas worth keeping.</p>
  </header>
  {posts.length ? (
    <PostList posts={posts} />
  ) : (
    <p class="empty-state">No notes published yet.</p>
  )}
</Base>
