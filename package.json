{
  "name": "thiesen-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "astro preview --host 127.0.0.1",
    "dev": "bun run content:check && NODE_ENV=development astro dev --host 127.0.0.1",
    "build": "bun run content:check && NODE_ENV=production astro build",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "oxlint --report-unused-disable-directives .",
    "format": "oxfmt --check . && prettier --check 'src/**/*.astro'",
    "check": "bun run lint && bun run format && bun run content:check",
    "check:write": "oxlint --fix --report-unused-disable-directives . && oxfmt --write . && prettier --write 'src/**/*.astro'",
    "content:check": "bun tools/content-check.ts",
    "test": "bun test",
    "verify": "bun run check && bun run typecheck && bun test && bun run build",
    "deploy": "bun run check && bun run typecheck && bun test && alchemy deploy",
    "deploy:plan": "alchemy plan"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/solid-js": "7.0.2",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "astro": "7.3.5",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "solid-js": "1.9.15",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@micthiesen/mitools": "4.1.0",
    "@types/bun": "^1.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "24.13.3",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.115",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115"
  },
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=24.14.0 <25"
  },
  "packageManager": "bun@1.3.11"
}
