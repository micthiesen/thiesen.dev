{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 88,
  "singleQuote": false,
  "trailingComma": "all",
  "semi": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    ".astro/**",
    ".wrangler/**",
    "**/*.astro",
    "**/*.md",
    "bun.lock"
  ]
}
